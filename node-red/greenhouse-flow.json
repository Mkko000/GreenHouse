    "id": "gh.in.state",
    "type": "mqtt in",
    "name": "greenhouse/state",
    "topic": "greenhouse/state",
    "qos": "1",
    "datatype": "json",
    "broker": "gh.broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
