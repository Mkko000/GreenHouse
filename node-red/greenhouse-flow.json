  {
    "id": "gh.fn.split",
    "type": "function",
    "name": "Split state",
    "func": "// Fan the JSON state out to the widgets. Output order:\n// 1 temperature · 2 humidity · 3 soil · 4 light · 5 chart · 6 pump · 7 fans · 8 lights · 9 mode · 10 alerts\nconst s = msg.payload;\nif (typeof s !== 'object' || s === null) return null;\n\nconst isNum = (v) => typeof v === 'number' && Number.isFinite(v);\nconst reading = (v) => (isNum(v) ? { payload: v } : null);\n\nconst chart = [];\nif (isNum(s.temperature)) chart.push({ topic: 'Temperature (°C)', payload: s.temperature });\nif (isNum(s.humidity)) chart.push({ topic: 'Humidity (%)', payload: s.humidity });\n\n// Alerts fire once when a problem starts, not on every update.\nconst alerts = [];\nfunction edge(key, active, text) {\n    const was = context.get(key) || false;\n    if (active && !was) alerts.push({ payload: text });\n    context.set(key, active);\n}\nedge('hot', isNum(s.temperature) && s.temperature >= env.get('ALERT_TEMP_C'), `High temperature: ${s.temperature} °C`);\nedge('dry', isNum(s.soil) && s.soil <= env.get('ALERT_SOIL_PCT'), `Soil is very dry: ${s.soil} %`);\nedge('offline', s.online === false, 'Arduino link lost — check the UART wiring');\nedge('sensor', s.online === true && !isNum(s.temperature), 'DHT22 sensor error');\n\nconst mode = s.online === false ? 'Arduino offline' : (s.auto ? 'AUTO' : 'MANUAL');\n\nreturn [\n    reading(s.temperature),\n    reading(s.humidity),\n    reading(s.soil),\n    reading(s.light),\n    chart,\n    { payload: !!s.pump },\n    { payload: !!s.fan },\n    { payload: !!s.leds },\n    { payload: mode },\n    alerts\n];\n",
    "outputs": 10,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "env": [],
    "wires": [
      [
        "gh.g.temp"
      ],
      [
        "gh.g.hum"
      ],
      [
        "gh.g.soil"
      ],
      [
        "gh.g.light"
      ],
      [
        "gh.chart"
      ],
      [
        "gh.sw.pump"
      ],
      [
        "gh.sw.fan"
      ],
      [
        "gh.sw.leds"
      ],
      [
        "gh.txt.mode"
      ],
      [
        "gh.notify"
      ]
    ],
    "z": "gh.tab",
    "x": 390,
    "y": 220
