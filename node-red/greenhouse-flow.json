    "type": "function",
    "name": "To command",
    "func": "// Switch toggled by the user → \"PUMP_ON\" / \"FAN_OFF\" / ... on greenhouse/cmd\nmsg.payload = `${msg.topic}_${msg.payload ? 'ON' : 'OFF'}`;\nmsg.topic = 'greenhouse/cmd';\nreturn msg;\n",
