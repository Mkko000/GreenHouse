  {
    "id": "gh.fn.avail",
    "type": "function",
    "name": "Availability",
    "func": "// ESP32 availability (MQTT last will): show it, and alert when it drops.\nconst online = msg.payload === 'online';\nconst was = context.get('online');\ncontext.set('online', online);\nconst text = { payload: online ? 'Online' : 'Offline' };\nconst alert = (was === true && !online) ? { payload: 'ESP32-CAM went offline' } : null;\nreturn [text, alert];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
